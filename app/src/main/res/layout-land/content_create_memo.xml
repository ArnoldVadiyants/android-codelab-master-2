<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="com.sap.codelab.view.create.CreateMemo"
    tools:showIn="@layout/activity_create_memo">

    <!--
        Left column: scrollable form + location header.
        When MapView is GONE it collapses in the chain and left column expands to full width.
    -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/left_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="@dimen/padding_activity"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/location_map_view"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/memo_title_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:boxBackgroundColor="@android:color/transparent"
                app:boxBackgroundMode="outline"
                app:errorEnabled="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/memo_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/memo_title" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/memo_description_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:boxBackgroundColor="@android:color/transparent"
                app:boxBackgroundMode="outline"
                app:errorEnabled="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/memo_title_container">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/memo_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/memo_text" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Location section: Empty state -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/location_empty_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/memo_description_container">

                <ImageView
                    android:id="@+id/ic_location_empty"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@null"
                    android:padding="2dp"
                    android:src="@drawable/ic_location_filled"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_location_optional_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/location_optional"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/pick_location_button"
                    app:layout_constraintStart_toEndOf="@id/ic_location_empty"
                    app:layout_constraintTop_toTopOf="@id/ic_location_empty" />

                <TextView
                    android:id="@+id/tv_location_helper"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/location_helper_text"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toStartOf="@id/pick_location_button"
                    app:layout_constraintStart_toEndOf="@id/ic_location_empty"
                    app:layout_constraintTop_toBottomOf="@id/tv_location_optional_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pick_location_button"
                    style="@style/Widget.App.LocationButton.Pick"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pick_location"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Location section: Selected state (map is in the right column) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/location_selected_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/memo_description_container">

                <ImageView
                    android:id="@+id/ic_location_selected"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@null"
                    android:padding="2dp"
                    android:src="@drawable/ic_location_filled"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_location_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/location"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ic_location_selected"
                    app:layout_constraintTop_toTopOf="@id/ic_location_selected" />

                <TextView
                    android:id="@+id/location_coordinates"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ic_location_selected"
                    app:layout_constraintTop_toBottomOf="@id/tv_location_title"
                    tools:text="42.15798, 24.73935" />

                <androidx.constraintlayout.widget.Barrier
                    android:id="@+id/barrier_selected_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:barrierDirection="bottom"
                    app:constraint_referenced_ids="ic_location_selected,location_coordinates" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/change_location_button"
                    style="@style/Widget.App.LocationButton.Change"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="4dp"
                    android:text="@string/change_location"
                    app:layout_constraintEnd_toStartOf="@id/clear_location_button"
                    app:layout_constraintHorizontal_chainStyle="spread_inside"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/barrier_selected_header" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clear_location_button"
                    style="@style/Widget.App.LocationButton.Clear"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/clear_location"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_chainStyle="spread_inside"
                    app:layout_constraintStart_toEndOf="@id/change_location_button"
                    app:layout_constraintTop_toBottomOf="@id/barrier_selected_header" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <!--
        Right column: full-height map preview.
        GONE when no location → left column expands to full width via chain weight.
        VISIBLE when location selected → takes 50% of screen width.
    -->
    <com.sap.codelab.core.location.OsmLocationMapView
        android:id="@+id/location_map_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/left_scroll"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
